{
  "name": "velmux-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-docs.mjs && next build",
    "dev": "node scripts/sync-docs.mjs && next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "sync": "node scripts/sync-docs.mjs",
    "deploy": "cd .. && vercel pull --yes --environment=production && vercel build --prod && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.5.15"
  }
}
